* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: Arial, sans-serif;
    background: #f5f7f6;
    color: #17221d;
    line-height: 1.6;
}


/* HEADER */

.header {
    min-height: 75px;
    background: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 15px 7%;

    border-bottom: 1px solid #e5e9e7;

    position: sticky;
    top: 0;

    z-index: 100;
}


.logo {
    font-size: 20px;
    font-weight: bold;
}


.logo span {
    color: #147a4b;
}


nav {
    display: flex;
    gap: 25px;
}


nav a {
    text-decoration: none;
    color: #333;
    font-size: 15px;
}


nav a:hover {
    color: #147a4b;
}


/* HERO */

.hero {

    min-height: 600px;

    display: flex;
    align-items: center;

    padding: 80px 7%;

    background:
        linear-gradient(
            90deg,
            rgba(10, 45, 31, 0.95),
            rgba(10, 45, 31, 0.55)
        ),

        url("https://images.unsplash.com/photo-1500534623283-312aade485b7")
        center/cover;
}


.hero-content {
    max-width: 700px;
    color: white;
}


.badge {

    display: inline-block;

    background: #e8f5ee;

    color: #147a4b;

    padding: 7px 14px;

    border-radius: 30px;

    font-size: 12px;

    font-weight: bold;

    margin-bottom: 20px;
}


.hero .badge {

    background: rgba(255,255,255,0.15);

    color: white;
}


.hero h1 {

    font-size: 58px;

    line-height: 1.1;

    margin-bottom: 25px;
}


.hero h1 strong {

    color: #6ee7a5;
}


.hero p {

    font-size: 19px;

    max-width: 600px;

    margin-bottom: 35px;

    color: #e7eee9;
}


.hero-buttons {

    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}


.btn-primary,
.btn-secondary {

    padding: 14px 22px;

    border-radius: 8px;

    text-decoration: none;

    font-weight: bold;
}


.btn-primary {

    background: #42b978;

    color: white;
}


.btn-secondary {

    background: white;

    color: #173a29;
}


/* SECTIONS */

.section {

    padding: 90px 7%;
}


.section-title {

    max-width: 700px;

    margin-bottom: 45px;
}


.section-title span {

    color: #147a4b;

    font-size: 13px;

    font-weight: bold;
}


.section-title h2 {

    font-size: 38px;

    margin: 10px 0;
}


.section-title p {

    color: #65716b;
}


/* CARDS */

.cards {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}


.feature-card {

    background: white;

    padding: 35px;

    border-radius: 16px;

    border: 1px solid #e5e9e7;

    transition: 0.3s;
}


.feature-card:hover {

    transform: translateY(-5px);

    box-shadow:
        0 15px 35px rgba(0,0,0,0.08);
}


.icon {

    font-size: 40px;

    margin-bottom: 20px;
}


.feature-card h3 {

    margin-bottom: 12px;

    font-size: 21px;
}


.feature-card p {

    color: #65716b;

    margin-bottom: 20px;
}


.feature-card a {

    color: #147a4b;

    font-weight: bold;

    text-decoration: none;
}


/* ABOUT */

.about-section {

    background: #eaf4ee;

    padding: 90px 7%;
}


.about-section > div {

    max-width: 750px;
}


.about-section h2 {

    font-size: 38px;

    margin-bottom: 20px;
}


.about-section p {

    color: #526058;

    margin-bottom: 15px;
}


/* FOOTER */

footer {

    background: #10251b;

    color: white;

    padding: 60px 7%;

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 50px;
}


footer h3 {

    margin-bottom: 15px;
}


footer p {

    color: #b9c8bf;
}


footer a {

    display: block;

    color: #b9c8bf;

    text-decoration: none;

    margin: 7px 0;
}


.copyright {

    background: #09150f;

    color: #829187;

    text-align: center;

    padding: 18px;

    font-size: 13px;
}


/* TELEPHONE */

@media (max-width: 800px) {

    .header {

        height: auto;

        padding: 20px;

        flex-direction: column;

        gap: 15px;
    }


    nav {

        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }


    .hero {

        min-height: 520px;

        padding: 60px 25px;
    }


    .hero h1 {

        font-size: 43px;
    }


    .hero p {

        font-size: 17px;
    }


    .section {

        padding: 60px 25px;
    }


    .section-title h2,
    .about-section h2 {

        font-size: 30px;
    }


    .cards {

        grid-template-columns: 1fr;
    }


    footer {

        grid-template-columns: 1fr;

        padding: 45px 25px;
    }

}
.whatsapp-btn {
    background: #25D366;
    color: white !important;
    padding: 9px 15px;
    border-radius: 8px;
    font-weight: bold;
}

.whatsapp-btn:hover {
    opacity: 0.85;
}
/* =========================
   ADMIN LOGIN
========================= */

.admin-page {

    min-height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 25px;

    background:
        linear-gradient(
            135deg,
            #10251b,
            #147a4b
        );
}


.admin-login {

    width: 100%;

    max-width: 420px;

    background: white;

    padding: 40px;

    border-radius: 18px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.25);
}


.admin-logo {

    width: 65px;

    height: 65px;

    margin: 0 auto 20px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #e8f5ee;

    border-radius: 50%;

    font-size: 32px;
}


.admin-login h1 {

    text-align: center;

    font-size: 25px;

    margin-bottom: 5px;
}


.admin-subtitle {

    text-align: center;

    color: #147a4b;

    margin-bottom: 30px;
}


.admin-login label {

    display: block;

    font-weight: bold;

    font-size: 14px;

    margin: 15px 0 7px;
}


.admin-login input {

    width: 100%;

    padding: 13px;

    border: 1px solid #d9e0dc;

    border-radius: 8px;

    font-size: 15px;

    outline: none;
}


.admin-login input:focus {

    border-color: #147a4b;
}


.admin-login button {

    width: 100%;

    margin-top: 25px;

    padding: 14px;

    border: none;

    border-radius: 8px;

    background: #147a4b;

    color: white;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;
}


.admin-login button:hover {

    opacity: 0.9;
}


.error-message {

    background: #ffe8e8;

    color: #a51d1d;

    padding: 12px;

    border-radius: 8px;

    margin-bottom: 15px;

    font-size: 14px;
}


.back-home {

    display: block;

    text-align: center;

    margin-top: 25px;

    color: #147a4b;

    text-decoration: none;

    font-size: 14px;
}
/* =========================
   ADMIN DASHBOARD
========================= */

.admin-header {

    min-height: 70px;

    background: #10251b;

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 15px 7%;
}


.admin-header a {

    color: white;

    text-decoration: none;

    background: rgba(255,255,255,0.12);

    padding: 9px 15px;

    border-radius: 7px;
}


.admin-dashboard {

    padding: 60px 7%;

    background: #f5f7f6;

    min-height: calc(100vh - 70px);
}


.dashboard-welcome {

    margin-bottom: 40px;
}


.dashboard-welcome span {

    color: #147a4b;

    font-size: 12px;

    font-weight: bold;
}


.dashboard-welcome h1 {

    font-size: 35px;

    margin: 8px 0;
}


.dashboard-welcome p {

    color: #65716b;
}


.admin-actions {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}


.admin-card {

    background: white;

    padding: 28px;

    border-radius: 15px;

    border: 1px solid #e1e7e3;
}


.admin-icon {

    font-size: 35px;

    margin-bottom: 15px;
}


.admin-card h2 {

    font-size: 20px;

    margin-bottom: 10px;
}


.admin-card p {

    color: #65716b;

    min-height: 50px;

    margin-bottom: 20px;
}


.admin-card button {

    width: 100%;

    padding: 11px;

    border: none;

    border-radius: 7px;

    background: #147a4b;

    color: white;

    font-weight: bold;
}


@media (max-width: 900px) {

    .admin-actions {

        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 600px) {

    .admin-actions {

        grid-template-columns: 1fr;
    }

    .admin-dashboard {

        padding: 40px 20px;
    }

    .dashboard-welcome h1 {

        font-size: 28px;
    }

}
